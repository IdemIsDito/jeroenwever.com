---
import { useTranslations, type Locale } from '../i18n';
import type { Resume } from '../content/schema';

interface Props {
  locale: Locale;
  basics: Resume['basics'];
}

const { locale, basics } = Astro.props;
const t = useTranslations(locale);
---

<footer>
  <p class="outro">
    {t('outro.line')} <a href={`mailto:${basics.email}`}>{basics.email}</a>
  </p>
  <p class="mono srd">
    {t('footer.builtWith')} — <a href="https://github.com/IdemIsDito/jeroenwever.com"
      >{t('footer.source')}</a
    >. {basics.name} {t('footer.operatesAs')} <span class="op">Sugar Rush Development</span> — coding
    with the speed of sweet
  </p>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5) var(--page-pad) var(--space-6);
  }

  .outro {
    margin: 0;
    font-size: var(--text-lg);
  }

  .srd {
    margin: 0;
  }

  /* Accent text: plum on Icing, raspberry on Liquorice. */
  .op {
    color: var(--color-accent);
  }
</style>
