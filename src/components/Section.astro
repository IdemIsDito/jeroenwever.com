---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`} class="kicker">{title}</h2>
  <div class="body"><slot /></div>
</section>

<style>
  /* A label column beside the content, so the page reads as a set of rows. */
  section {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-6);
    padding: var(--space-5) var(--page-pad);
    /* The sheet's nav jumps here; clear the sticky bar so the label lands visible. */
    scroll-margin-top: var(--topbar-height);

    @media (max-width: 48rem) {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  h2 {
    margin: 0;
    letter-spacing: 0.12em;
  }

  .body {
    min-width: 0;
  }
</style>
