---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`} class="kicker">{title}</h2>
  <div class="body"><slot /></div>
</section>

<style>
  /*
   * The label sits above its content at every width. A side-by-side label
   * column reads poorly here — the eye has to travel back and forth across a
   * gap that carries no information — so desktop keeps the mobile stacking.
   */
  section {
    padding: var(--space-5) var(--page-pad);
    scroll-margin-top: var(--space-3);
  }

  h2 {
    margin: 0 0 var(--space-3);
    letter-spacing: 0.12em;
  }

  .body {
    min-width: 0;
  }
</style>
