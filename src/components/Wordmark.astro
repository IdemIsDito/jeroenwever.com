---
/*
 * Three skewed bars plus the logotype. One colour per element on both themes —
 * raspberry, sherbet, teal third bar, and a raspberry .dev. A logotype carries
 * no contrast requirement, so none of them step between themes.
 */
interface Props {
  wordmark: string;
  /** Renders the mark as a link back to the top of the page. */
  href?: string;
  /** The three-bar glyph belongs to the .dev mark; the personal mark is type only. */
  bars?: boolean;
}

const { wordmark, href, bars = true } = Astro.props;
const [name, tld] = wordmark.split(/(?=\.)/); // "sugarrush" + ".dev"
const Tag = href ? 'a' : 'span';
/*
 * The logotype is exposed as a single image with an accessible name, not as
 * live text: WCAG 1.4.3 exempts brand marks from the contrast minimum, and
 * raspberry .dev on Icing is 2.9:1 by design. As a link the element keeps its
 * link role and takes the name from aria-label instead.
 */
const role = href ? undefined : 'img';
---

<Tag class="mark" href={href} role={role} aria-label={wordmark}>
  {bars && <span class="bars" aria-hidden="true"><i /><i /><i /></span>}
  <span class="type" aria-hidden="true">{name}<span class="tld" data-logotype>{tld}</span></span>
</Tag>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .bars {
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .bars i {
    width: 7px;
    height: 24px;
    border-radius: var(--radius-xs);
    transform: skewX(var(--band-skew));
  }

  .bars i:nth-child(1) {
    background: var(--color-raspberry);
  }

  .bars i:nth-child(2) {
    background: var(--color-sherbet);
  }

  .bars i:nth-child(3) {
    background: var(--color-signal-mark);
  }

  .type {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .tld {
    color: var(--color-raspberry);
  }
</style>
