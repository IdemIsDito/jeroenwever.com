---
/*
 * Three skewed bars plus the logotype. One colour per element on both themes —
 * raspberry, sherbet, teal third bar, and a raspberry tail on the type. A
 * logotype carries no contrast requirement, so none of them step between
 * themes, and the tail is marked so the axe gate can honour WCAG 1.4.3.
 */
interface Props {
  /** The part set in the text colour, e.g. "sugarrush" or "jeroen". */
  lead: string;
  /** The part set in raspberry, e.g. ".dev" or "wever.". */
  accent: string;
  /** Renders the mark as a link back to the top of the page. */
  href?: string;
}

const { lead, accent, href } = Astro.props;
const Tag = href ? 'a' : 'span';
const role = href ? undefined : 'img';
---

<Tag class="mark" href={href} role={role} aria-label={`${lead}${accent}`}>
  <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
  <span class="type" aria-hidden="true">{lead}<span class="tail" data-logotype>{accent}</span></span>
</Tag>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .bars {
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .bars i {
    width: 7px;
    height: 24px;
    border-radius: var(--radius-xs);
    transform: skewX(var(--band-skew));
  }

  .bars i:nth-child(1) {
    background: var(--color-raspberry);
  }

  .bars i:nth-child(2) {
    background: var(--color-sherbet);
  }

  .bars i:nth-child(3) {
    background: var(--color-signal-mark);
  }

  .type {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .tail {
    color: var(--color-raspberry);
  }
</style>
