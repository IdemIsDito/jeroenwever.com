---
import Wordmark from './Wordmark.astro';
import MenuSheet from './MenuSheet.astro';
import { useTranslations, altLocale, localePath, cvFileName, type Locale } from '../i18n';
import type { Resume } from '../content/schema';

interface Props {
  locale: Locale;
  basics: Resume['basics'];
  /** Section ids the sheet's nav jumps to, in page order. */
  sections: { id: string; title: string }[];
}

const { locale, basics, sections } = Astro.props;
const t = useTranslations(locale);
const other = altLocale(locale);
const tOther = useTranslations(other);
const cv = cvFileName(locale);

/* The personal mark splits at the surname, so "wever." carries the raspberry. */
const [lead = '', accent = ''] = (() => {
  const [first, last] = basics.name.toLowerCase().split(/\s+/);
  return [first ?? '', `${last ?? ''}.`];
})();

const contact = [
  { href: basics.linkedin, label: t('sidebar.linkedin') },
  { href: basics.github, label: t('sidebar.github') },
  { href: `mailto:${basics.email}`, label: basics.email },
] as const;
---

<div class="topbar shell">
  <Wordmark lead={lead} accent={accent} href="#main" />
  <MenuSheet locale={locale} lead={lead} accent={accent}>
    <nav slot="nav" class="group" aria-label={t('menu.sections')}>
      <p class="kicker">{t('menu.sections')}</p>
      <ul>
        {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
      </ul>
    </nav>
    <div class="sheet-links">
      <a href={`/${cv}`} download>{t('hero.download')} <span aria-hidden="true">↓</span></a>
      {contact.map((c) => <a href={c.href}>{c.label}</a>)}
      <a href={localePath(other)} hreflang={other} lang={other}>
        {tOther('locale.altPage')} <span aria-hidden="true">→</span>
      </a>
    </div>
  </MenuSheet>
</div>

<header class="hero shell">
  <!-- Availability is a dot and a line of type in content, never a header pill. -->
  <p class="availability"><span class="status-dot" aria-hidden="true"></span>{t('availability')}</p>

  <h1>{basics.name}</h1>

  <p class="intro">{basics.intro} — <span class="emphasis">{basics.tagline}</span></p>

  <div class="actions">
    <a class="btn" href={`/${cv}`} download>{t('hero.download')} <span aria-hidden="true">↓</span></a>
  </div>

  <nav class="contact" aria-label={t('sidebar.contactNav')}>
    <ul>
      {contact.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
    </ul>
  </nav>

  <p class="alt-page">
    <a href={localePath(other)} hreflang={other} lang={other}>
      {tOther('locale.altPage')} <span aria-hidden="true">→</span>
    </a>
  </p>
</header>

<style>
  /* Matches sugarrush.dev: transparent, in flow, crossing the band. */
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--topbar-height);
    padding: var(--space-4) var(--page-pad) 0;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6) var(--page-pad);
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-kicker);
    color: var(--color-muted);
  }

  /* Sherbet on Liquorice, plum on Icing. */
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-status);
  }

  h1 {
    margin: 0;
    max-width: 16ch;
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: var(--track-display);
  }

  .intro {
    margin: 0;
    max-width: 40ch;
    font-size: var(--text-xl);
    line-height: 1.5;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .emphasis {
    color: var(--color-text);
  }

  .actions {
    display: flex;
    gap: var(--space-3);
  }

  /* The primary action is the one raspberry fill; its text is always Liquorice. */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding-inline: 23px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-on-raspberry);
    background: var(--color-raspberry);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background-color var(--motion) ease;

    &:hover {
      background: var(--color-raspberry-hover);
      color: var(--color-on-raspberry);
    }
  }

  .contact ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  .alt-page {
    margin: 0;
    font-size: var(--text-sm);
  }

  /* Sheet nav — the section list above the switch pills. */
  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .group ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-base);
  }

  .sheet-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }
</style>
