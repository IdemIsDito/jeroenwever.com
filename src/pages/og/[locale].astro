---
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import { getResume } from '../../content';
import { locales, useTranslations, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const { basics } = getResume(locale);
const t = useTranslations(locale);
const mark = basics.name.toLowerCase().replace(/\s+/g, '');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>og-image source</title>
    <style>
      * {
        margin: 0;
        box-sizing: border-box;
      }
      /* Icing ground, Liquorice ink — the light theme, rendered flat. */
      body {
        width: 1200px;
        height: 630px;
        background: #fbf7f3;
        color: #120e13;
        font-family: 'Space Grotesk Variable', Helvetica, Arial, sans-serif;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 80px;
        position: relative;
        overflow: hidden;
      }
      /* The band: three stripes at 16°, right-anchored, widest outermost. */
      .band span {
        position: absolute;
        top: -80px;
        bottom: -80px;
        transform: skewX(-16deg);
      }
      .b1 {
        right: -40px;
        width: 200px;
        background: oklch(0.94 0.025 320);
      }
      .b2 {
        right: 210px;
        width: 44px;
        background: oklch(0.9 0.04 320);
      }
      .b3 {
        right: 266px;
        width: 16px;
        background: oklch(0.96 0.018 320);
      }
      .content {
        position: relative;
      }
      .availability {
        display: flex;
        align-items: center;
        gap: 14px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 24px;
        color: #5c5259;
        margin-bottom: 28px;
      }
      .status {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: oklch(0.52 0.08 320);
      }
      h1 {
        font-size: 110px;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.045em;
      }
      /* The logotype keeps full-strength raspberry — brand text is exempt. */
      h1 .dot {
        color: oklch(0.68 0.21 20);
      }
      .title {
        font-size: 38px;
        font-weight: 600;
        margin-top: 28px;
      }
      .tagline {
        font-size: 32px;
        color: #5c5259;
        margin-top: 12px;
      }
    </style>
  </head>
  <body>
    <div class="band">
      <span class="b1"></span><span class="b2"></span><span class="b3"></span>
    </div>
    <div class="content">
      <p class="availability"><span class="status"></span>{t('availability')}</p>
      <h1>{mark}<span class="dot">.</span></h1>
      <p class="title">{basics.title}</p>
      <p class="tagline">{basics.tagline}</p>
    </div>
  </body>
</html>
